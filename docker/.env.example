# ──────────────────────────────────────────────────────────────
# ClearRoute Mini PC — Docker environment config
# Copy to .env and fill in your values before running compose
# ──────────────────────────────────────────────────────────────

# LAN IP of the mini PC (find with: ipconfig in Windows CMD)
# Used for n8n webhooks and the setup scripts
MINIPC_IP=192.168.1.XXX

# Timezone (used by n8n scheduler)
TIMEZONE=Europe/London

# ── Dify ──────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DIFY_SECRET_KEY=change-me-use-a-long-random-string

# Password for the first Dify admin account
DIFY_INIT_PASSWORD=change-me-strong-password

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=dify
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=dify

# ── Redis ─────────────────────────────────────────────────────
# Leave blank for no password (fine for local LAN use)
REDIS_PASSWORD=

# ── Dify Sandbox ──────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
SANDBOX_API_KEY=change-me-sandbox-key

# ── n8n ───────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
N8N_ENCRYPTION_KEY=change-me-n8n-key
N8N_USER=admin
N8N_PASSWORD=change-me-n8n-password
