# Copy to `.env` (same folder as compose.jarvis-agent.yml) and fill in.
# This file holds a secret — keep it on the minipc, never commit the real .env.

# Supabase service_role key for the Jarvis control-plane project
# (jarvis-control-plane, ref yoffekacztmvpfnzymgq) — NOT the ClearRoute
# production project. The matching project URL is already set in
# compose.jarvis-agent.yml.
# Find it: Supabase dashboard -> jarvis-control-plane -> Project Settings ->
# API -> Project API keys -> "service_role" (secret). It lets the worker
# read/write the job queue.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
