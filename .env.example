# Jarvis frontend configuration.
#
# Point the app at Jarvis's ISOLATED control-plane project
# (jarvis-control-plane, ref yoffekacztmvpfnzymgq) — NOT the ClearRoute
# production project. Jarvis was split off here so it can never touch live
# customer data. Set the same two vars in the Vercel project for the Jarvis
# deployment.
#
# The anon (publishable) key: Supabase -> jarvis-control-plane ->
# Project Settings -> API -> Project API keys -> "anon" / publishable.
REACT_APP_SUPABASE_URL=https://yoffekacztmvpfnzymgq.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_jarvis_control_plane_anon_key_here
